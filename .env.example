# Copy to .env and fill in. NEVER commit .env
# Django settings
DJANGO_SECRET_KEY=put-a-long-random-secret-here
DJANGO_DEBUG=1
# PostgreSQL (inside Dev Container, service name is postgres)
POSTGRES_USER=bookstore
POSTGRES_DB=bookstore
POSTGRES_PASSWORD=put-a-long-random-password-here
DATABASE_URL=postgres://bookstore:put-a-long-random-password-here@postgres:5432/bookstore
# Seller desk notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Research tools: set these in your operating system environment instead (see START-HERE.md)
# PERPLEXITY_API_KEY=
